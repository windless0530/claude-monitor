  .final{margin:0 16px 12px;padding:8px 12px;background:#0d1117;border:1px solid var(--border);border-radius:6px;font-family:ui-monospace,monospace;font-size:12.5px;white-space:pre-wrap;word-break:break-word;max-height:340px;overflow:auto;color:#7ee787}
  .tlh,.tlrow{display:grid;grid-template-columns:44px 66px 150px minmax(0,1fr);gap:10px;padding:5px 12px;align-items:baseline}
  .tlh{color:var(--dim);font-size:12px;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:#11161d}
  .tlrow{border-bottom:1px solid #21262d;font-size:12.5px}
  .tlrow:hover{background:#1c2129}
  .tlrow.llm{background:rgba(163,113,247,.06);border-left:2px solid var(--purple)}
  .tlrow.llm:hover{background:rgba(163,113,247,.13)}
  .seq,.tltime{color:var(--dim);font-family:ui-monospace,monospace;white-space:nowrap}
  .tool{font-family:ui-monospace,monospace;white-space:nowrap;padding:1px 8px;border-radius:6px;font-weight:600}
  .arg{font-family:"Source Code Pro",ui-monospace,monospace;word-break:break-word;color:#c9d1d9;min-width:0}
  .sub{color:var(--pink);font-size:11px;margin-left:4px}
  .llmbadge{font-family:ui-monospace,monospace;color:var(--purple);font-weight:600;white-space:nowrap}
  .llmmeta{color:var(--dim);font-size:11.5px}
  .chip{display:inline-block;background:#21262d;border:1px solid var(--border);border-radius:8px;padding:0 7px;font-size:11px;margin:1px 3px 1px 0;color:var(--cyan);font-family:ui-monospace,monospace}
  details.think{margin:2px 0}
  details.think summary{cursor:pointer;color:var(--dim);font-size:11.5px;user-select:none}
  details.think summary:hover{color:var(--fg)}
  details.think pre{margin:3px 0;padding:6px 10px;background:#0d1117;border:1px solid var(--border);border-radius:6px;font-size:12px;white-space:pre-wrap;word-break:break-word;max-height:320px;overflow:auto;color:#c9d1d9}
  details.json{margin:4px 0}
  details.json summary{cursor:pointer;color:var(--accent);font-size:12px;user-select:none}
  .jsec{color:var(--dim);font-size:11px;margin:6px 0 2px;letter-spacing:.05em}
  /* —— JSON 树（VSCode 风格）—— */
  .jtree{font-family:"Source Code Pro",ui-monospace,"SFMono-Regular",Consolas,monospace;font-size:12px;line-height:1.75;color:#e6edf3;padding:6px 8px;background:#0d1117;border:1px solid var(--border);border-radius:6px;margin-top:3px;overflow-x:auto}
  .jtr{white-space:pre-wrap;word-break:break-word}
  .jtr .jtc{display:inline-block;width:14px;color:var(--dim);cursor:pointer;user-select:none}
  .jtr .jtc:hover{color:var(--fg)}
  .jtk2{color:#9cdcfe}
  .jtv-s{color:#ce9178}
  .jtv-n{color:#b5cea8}
  .jtv-b{color:#569cd6;font-style:italic}
  .jtb{color:#d7ba7d}
  .jtkids{margin-left:18px;border-left:1px solid #21262d;padding-left:2px}
  .jstr-more{color:var(--accent);cursor:pointer;font-size:11px;margin-left:6px;user-select:none}
  .shead{display:flex;gap:18px;flex-wrap:wrap;padding:14px 16px;color:var(--dim);font-size:13px;border-bottom:1px solid var(--border)}
  .shead b{color:var(--fg);font-weight:500}
  .empty{color:var(--dim);text-align:center;padding:60px 0}
  #err{color:var(--pink);padding:10px 20px;font-size:13px;display:none}
</style>
</head>
<body>
<header>
  <button id="back">← 会话列表</button>
  <h1><span class="dot"></span>ccmon · 会话与工具调用</h1>
  <input id="filter" placeholder="过滤：目录 / 命令 / 会话 id…">
</header>
<div id="err"></div>
<main id="view"><div class="empty">加载中…</div></main>
<script>
"use strict";
const $=s=>document.querySelector(s);
const view=$("#view"), errBox=$("#err");
let openTurns=new Set(), callsCache={}, llmCache={}, lastHtml=null;

const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmtT=iso=>{if(!iso)return"—";const d=new Date(iso);return isNaN(d)?iso:d.toLocaleTimeString("zh-CN",{hour12:false})};
const fmtD=iso=>{if(!iso)return"—";const d=new Date(iso);return isNaN(d)?iso:d.toLocaleString("zh-CN",{hour12:false})};
const dur=(a,b)=>{if(!a||!b)return"…";const ms=new Date(b)-new Date(a);if(isNaN(ms)||ms<0)return"…";
  const s=Math.round(ms/1000),m=Math.floor(s/60),h=Math.floor(m/60);
  return h?`${h}h${m%60}m`:m?`${m}m${s%60}s`:`${s}s`};
const active=s=>!s.ended_at||(Date.now()-new Date(s.last_activity||s.started_at))<15*60*1000;

const TOOL_COLOR={Read:"#3fb950",Bash:"#d29922",Edit:"#e3b341",MultiEdit:"#e3b341",Write:"#2f81f7",
  NotebookEdit:"#2f81f7",Grep:"#a371f7",Glob:"#a371f7",Task:"#f778ba",Agent:"#f778ba",
  WebFetch:"#39c5cf",WebSearch:"#39c5cf",Skill:"#39c5cf",AskUserQuestion:"#f0883e",ExitPlanMode:"#f0883e"};
const ARG_KEYS=["command","file_path","pattern","description","prompt","url","path","query","skill","name","todo"];

function argSummary(input){
  if(input==null)return"";
  let o=input;try{o=typeof input==="string"?JSON.parse(input):input}catch(e){}
  if(o==null||typeof o!=="object")return esc(String(o)).slice(0,80);
  for(const k of ARG_KEYS){if(o[k]!=null&&String(o[k])!==""){return esc(String(o[k])).slice(0,90)}}
  const ks=Object.keys(o).slice(0,3).map(k=>k+"="+String(o[k]).slice(0,20));
  return esc(ks.join(" "))||"{}";
}
// ---------- JSON 树（VSCode 风格：key/类型着色/折叠/懒展开） ----------
// 注册表 key 必须是确定性的（树 key+内容路径）：同一份数据每次渲染产出完全相同的 HTML，
// 这样轮询刷新的 html!==lastHtml 短路才成立，用户的展开状态才不会被无谓重写丢掉。
const jtReg=new Map();
const jtCaret=open=>`<span class="jtc">${open?"▾":"▸"}</span>`;
function jtLeaf(key,v,pk){
  const t=v===null?"null":typeof v;
  let vs;
  if(t==="string"){
    vs=`<span class="jtv-s">"${esc(v.length>400?v.slice(0,400):v)}"${v.length>400?"…":""}</span>`;
    if(v.length>400){jtReg.set(pk,v);vs+=`<span class="jstr-more" data-ref="${esc(pk)}">显示全部 ${v.length} 字符</span>`}
  }else if(t==="number")vs=`<span class="jtv-n">${String(v)}</span>`;
  else vs=`<span class="jtv-b">${String(v)}</span>`;
  return `<div class="jtr"><span class="jtc"></span>${key!==null?`<span class="jtk2">${esc(key)}: </span>`:""}${vs}</div>`;
}
function jtNode(key,v,depth,pk){
  if(v===null||typeof v!=="object")return jtLeaf(key,v,pk);   // 叶子兜底（字符串会被 Object.keys 拆成下标导致死递归）
  const isArr=Array.isArray(v);
  const ks=isArr?v.map((_,i)=>String(i)):Object.keys(v);
  const label=`${key!==null?`<span class="jtk2">${esc(key)}: </span>`:""}<span class="jtb">${isArr?"[":"{"}${ks.length}${isArr?"]":"}"}</span>`;
  if(!ks.length)return `<div class="jtr"><span class="jtc"></span>${label}</div>`;
  const open=depth<1, big=ks.length>40;
  const kid=k=>{const x=v[k];const cpk=pk+"."+k;
    return (x!==null&&typeof x==="object")?jtNode(k,x,depth+1,cpk):jtLeaf(k,x,cpk+":s")};
  let kids;
  if(big&&!open){
    jtReg.set(pk,v);
    kids=`<div class="jtkids" style="display:none" data-lazy="1" data-pkey="${esc(pk)}"></div>`;
  }else{
    kids=`<div class="jtkids" style="display:${open?"":"none"}" data-pkey="${esc(pk)}">${ks.map(kid).join("")}</div>`;
  }
  return `<div class="jtn"><div class="jtr">${jtCaret(open)}${label}</div>${kids}</div>`;
}
function jsonTree(src,tkey){
  if(src==null)return"";
  if(jtReg.size>8000)jtReg.clear();
  let v;try{v=typeof src==="string"?JSON.parse(src):src}catch(e){return `<pre style="margin:0;white-space:pre-wrap;word-break:break-word">${esc(src)}</pre>`}
  if(v===null||typeof v!=="object")return `<div class="jtree">${jtLeaf(null,v,tkey+":s")}</div>`;
  return `<div class="jtree">${jtNode(null,v,0,tkey)}</div>`;
}
// 懒填充大节点（点击展开与刷新恢复共用）
function jtFill(kids){
  if(!kids.dataset.lazy||kids.childNodes.length)return;
  const v=jtReg.get(kids.dataset.pkey);
  if(v!=null){
    const ks=Array.isArray(v)?v.map((_,i)=>String(i)):Object.keys(v);
    const pk=kids.dataset.pkey;
    const kid=k=>{const x=v[k];const cpk=pk+"."+k;
      return (x!==null&&typeof x==="object")?jtNode(k,x,1,cpk):jtLeaf(k,x,cpk+":s")};
    kids.innerHTML=ks.map(kid).join("");
  }
  delete kids.dataset.lazy;
}
// ---------- 时间线行 ----------
function toolRow(c,i,turnId){
  const col=TOOL_COLOR[c.tool_name]||"#8b949e";
  const tk=`t${turnId}c${c.call_id}`;
  return `<div class="tlrow tool">
    <span class="seq">#${i+1}</span><span class="tltime">${fmtT(c.ts)}</span>
    <span><span class="tool" style="color:${col}">${esc(c.tool_name)}</span>${c.is_subagent?'<span class="sub">★子代理</span>':""}</span>
    <div class="arg">${argSummary(c.tool_input)}
      <details class="json" data-dkey="${tk}-j"><summary>参数 / 响应</summary>
        <div class="jsec">tool_input</div>${jsonTree(c.tool_input,tk+"i")}
        <div class="jsec">tool_response</div>${jsonTree(c.tool_response,tk+"r")}
      </details></div></div>`;
}
const fmtK=n=>n==null?"":n>=1000?(n/1000).toFixed(n>=10000?0:1)+"k":String(n);
function llmRow(l,turnId){
  let tools=[];try{tools=JSON.parse(l.tool_uses||"[]")}catch(e){}
  const chips=tools.map(t=>`<span class="chip">${esc(t)}</span>`).join("");
  const tk=[];
  if(l.input_tokens!=null)tk.push(`in ${fmtK(l.input_tokens)}`);
  if(l.output_tokens!=null)tk.push(`out ${fmtK(l.output_tokens)}`);
  if(l.cache_read_tokens!=null)tk.push(`cache ${fmtK(l.cache_read_tokens)}`);
  const body=[];
  if(l.thinking)body.push(`<details class="think" data-dkey="t${turnId}l${l.llm_id}-th"><summary>思考过程</summary><pre>${esc(l.thinking)}</pre></details>`);
  if(l.text)body.push(`<details class="think" data-dkey="t${turnId}l${l.llm_id}-tx"><summary>输出文本</summary><pre>${esc(l.text)}</pre></details>`);
  if(chips)body.push(`<div style="margin-top:2px">${chips}</div>`);
  return `<div class="tlrow llm">
    <span class="seq">✦</span><span class="tltime">${fmtT(l.ts)}</span>
    <span><span class="llmbadge">${esc(l.model||"llm")}</span>${l.stop_reason?` <span class="llmmeta">${esc(l.stop_reason)}</span>`:""}${l.is_subagent?'<span class="sub">★子</span>':""}</span>
    <div>${body.join("")||'<span class="llmmeta">（无文本内容）</span>'}${tk.length?`<div class="llmmeta" style="margin-top:2px">${tk.join(" · ")}</div>`:""}</div>
  </div>`;
}
function timeline(calls,llm,turnId){
  let ti=0;
  const rows=[
    ...(calls||[]).map(c=>({ts:c.ts||"",h:toolRow(c,ti++,turnId)})),
    ...(llm||[]).map(l=>({ts:l.ts||"",h:llmRow(l,turnId)})),
  ].sort((a,b)=>a.ts<b.ts?-1:a.ts>b.ts?1:0);
  if(!rows.length)return'<div style="color:var(--dim);padding:10px 12px">（无调用记录）</div>';
  return `<div class="tlh"><span>#</span><span>时间</span><span>类型</span><span>内容（✦=模型推理；参数树可折叠）</span></div>${rows.map(r=>r.h).join("")}`;
}
function turnCard(t){
  const open=openTurns.has(t.turn_id);
  const callsHtml=open?timeline(callsCache[t.turn_id],llmCache[t.turn_id],t.turn_id):"";
  return `<div class="card">
    <div class="turn-h" data-turn="${t.turn_id}">
      <span class="badge count">轮次</span>
      <span class="t">${fmtD(t.submitted_at)}</span>
      <span class="badge count">${t.tool_count} 调用</span>
      <span class="badge count">${t.llm_count||0} 推理</span>
      <span class="badge">${t.finished_at?dur(t.submitted_at,t.finished_at):"进行中"}</span>
      <span class="cmd">❯ ${esc(t.prompt||"").slice(0,120)}</span>
    </div>
    ${open?`<pre class="prompt-full">❯ ${esc(t.prompt||"")}</pre>${callsHtml}
      <div class="final-h">最终输出</div>
      <div class="final">${esc(t.final_output||"（无文本输出）")}</div>`:""}
  </div>`;
}
function renderList(rows,f){
  if(f){const q=f.toLowerCase();rows=rows.filter(s=>(s.cwd||"").toLowerCase().includes(q)||(s.last_prompt||"").toLowerCase().includes(q)||(s.session_id||"").includes(q))}
  if(!rows.length)return'<div class="empty">暂无会话记录</div>';
  return rows.map(s=>`<div class="card"><div class="srow" data-sid="${esc(s.session_id)}">
    <span class="t">${fmtD(s.started_at)}</span>
    <span class="cwd">${esc((s.cwd||"").replace(/^\/home\/[^/]+/,"~"))}</span>
    <span class="prompt">${esc(s.last_prompt||"").slice(0,110)}</span>
    <span class="badge count">${s.turn_count} 轮</span>
    <span class="badge count">${s.tool_count} 调用</span>
    <span class="badge count">${s.llm_count||0} 推理</span>
    <span class="badge ${active(s)?"on":""}">${active(s)?"进行中":fmtT(s.ended_at)}</span>
  </div></div>`).join("");
}
function renderSession(d){
  const s=d.session;
  const head=`<div class="shead">
    <span>目录 <b>${esc(s.cwd||"?")}</b></span><span>模型 <b>${esc(s.model||"?")}</b></span>
    <span>开始 <b>${fmtD(s.started_at)}</b></span><span>结束 <b>${active(s)?"进行中":fmtD(s.ended_at)}</b></span>
    <span><b>${s.turn_count}</b> 轮</span><span><b>${s.tool_count}</b> 次调用</span><span><b>${s.llm_count||0}</b> 次推理</span>
    <span>id <b>${esc(s.session_id.slice(0,8))}…</b></span></div>`;
  return head+(d.turns.length?d.turns.map(turnCard).join(""):'<div class="empty">该会话暂无轮次</div>');
}
async function getJSON(url){const r=await fetch(url);if(!r.ok)throw new Error(`${r.status} ${url}`);return r.json()}

async function refresh(){
  try{
    errBox.style.display="none";
    const h=location.hash;
    if(h.startsWith("#/s/")){
      const sid=decodeURIComponent(h.slice(4));
      const d=await getJSON("api/sessions/"+encodeURIComponent(sid));
      await Promise.all(d.turns.filter(t=>openTurns.has(t.turn_id)).map(async t=>{
        const c=await getJSON("api/turns/"+t.turn_id);
        callsCache[t.turn_id]=c.calls;llmCache[t.turn_id]=c.llm||[]}));
      const html=renderSession(d);
      if(html!==lastHtml){
        // 渲染是确定性的：数据没变就不会走到这里。数据真变了（活跃会话）重写 DOM 前
        // 快照交互状态（展开的 details / 展开的树节点 / 展开的字符串），写完按稳定 key 恢复。
        const openD=[...view.querySelectorAll("details[open][data-dkey]")].map(x=>x.dataset.dkey);
        const openK=[...view.querySelectorAll(".jtkids[data-pkey]")]
          .filter(x=>x.style.display!=="none").map(x=>x.dataset.pkey);
        view.innerHTML=html;lastHtml=html;
        openD.forEach(k=>{const el=view.querySelector('details[data-dkey="'+CSS.escape(k)+'"]');if(el)el.open=true});
        openK.forEach(k=>{
          const el=view.querySelector('.jtkids[data-pkey="'+CSS.escape(k)+'"]');
          if(el){jtFill(el);el.style.display="";
            const c=el.parentElement&&el.parentElement.querySelector(":scope > .jtr .jtc");
            if(c)c.textContent="▾"}
        });
      }
    }else{
      const rows=await getJSON("api/sessions");
      const html=renderList(rows,$("#filter").value.trim());
      if(html!==lastHtml){view.innerHTML=html;lastHtml=html}
    }
  }catch(e){errBox.textContent="加载失败: "+e.message;errBox.style.display="block"}
}
view.addEventListener("click",e=>{
  const more=e.target.closest(".jstr-more");   // 长字符串展开
  if(more){
    const full=jtReg.get(more.dataset.ref);
    const s=more.parentElement.querySelector(".jtv-s");
    if(s&&full!=null)s.textContent=full;
    more.remove();return;
  }
  const caret=e.target.closest(".jtc");        // JSON 树折叠
  if(caret){
    const node=caret.closest(".jtn");
    const kids=node&&node.querySelector(":scope > .jtkids");
    if(kids){
      jtFill(kids);
      const show=kids.style.display==="none";
      kids.style.display=show?"":"none";
      caret.textContent=show?"▾":"▸";
    }
    return;
  }
  const row=e.target.closest(".srow");
  if(row){location.hash="#/s/"+encodeURIComponent(row.dataset.sid);return}
  const th=e.target.closest(".turn-h");
  if(th){const id=+th.dataset.turn;openTurns.has(id)?openTurns.delete(id):openTurns.add(id);lastHtml=null;refresh()}
});
$("#back").addEventListener("click",()=>{location.hash=""});
$("#filter").addEventListener("input",()=>{lastHtml=null;refresh()});
window.addEventListener("hashchange",()=>{
  $("#back").style.display=location.hash.startsWith("#/s/")?"inline-block":"none";
  openTurns.clear();callsCache={};llmCache={};lastHtml=null;refresh();
  if(!location.hash.startsWith("#/s/"))$("#filter").focus();
});
$("#back").style.display=location.hash.startsWith("#/s/")?"inline-block":"none";
refresh();
setInterval(()=>{if(document.visibilityState==="visible")refresh()},5000);
</script>
</body>
</html>
