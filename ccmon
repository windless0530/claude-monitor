#!/usr/bin/env bash
# ccmon — Claude Code OTel 监控栈一键工具
#
# 接口:
#   ccmon setup          引导式安装/配置（幂等，可重复运行）
#   ccmon restart        机器重启后拉起整个链路（docker + nginx + 校验）
#   ccmon start|stop     启停采集栈
#   ccmon status         全链路健康检查（只读）
#   ccmon events [N]     最近 N 次 API 调用明细（默认 10）
#   ccmon help
#
# 状态与配置: <INSTALL_DIR>/.env（compose 用）+ ccmon.state（本工具用），均 600 权限
# 所有修改操作（settings.json / nginx / compose）先备份再动手，nginx -t 失败自动回滚。

set -uo pipefail

# ---------- 基础工具 ----------
C_INFO=$'\033[1;32m'; C_WARN=$'\033[1;33m'; C_ERR=$'\033[1;31m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
info() { printf '%s[+]%s %s\n' "$C_INFO" "$C_OFF" "$*"; }
warn() { printf '%s[!]%s %s\n' "$C_WARN" "$C_OFF" "$*" >&2; }
err()  { printf '%s[x]%s %s\n' "$C_ERR" "$C_OFF" "$*" >&2; }
die()  { err "$*"; exit 1; }
hr()   { printf '%s── %s ──%s\n' "$C_DIM" "$*" "$C_OFF"; }

# 交互读取：回车=默认值；EOF/管道耗尽=默认值（可脚本化喂答案）
ask() { # ask <变量名> <提示> <默认值>
  local __ask_v __prompt="$2" __def="$3"
  printf '%s' "${__prompt} ${C_DIM}[${__def}]${C_OFF}: " >&2
  IFS= read -r __ask_v || __ask_v=""
  printf -v "$1" '%s' "${__ask_v:-$__def}"
}
ask_yn() { # ask_yn <变量名> <提示> <y|n>
  local _v __def="$3"
  ask _v "$2 (y/n)" "$__def"
  case "${_v,,}" in y|yes) printf -v "$1" 'y' ;; *) printf -v "$1" 'n' ;; esac
}
confirm_danger() { # 高危确认：必须显式输入变量值本身
  local _v
  printf '%s' "$1（输入该值确认）: " >&2
  IFS= read -r _v || _v=""
  [ "$_v" = "$2" ] || die "未确认，中止"
}

have() { command -v "$1" >/dev/null 2>&1; }
need() { have "$1" || die "缺少依赖: $1"; }

sudo_run() {
  if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi
}

# docker 需要时自动加 sudo（ubuntu 入组但旧会话未生效等场景）
docker_cmd() {
  if docker info >/dev/null 2>&1; then docker "$@"; else sudo docker "$@"; fi
}

# ---------- 默认参数 ----------
declare -A DEFAULTS
DEFAULTS=(
  [INSTALL_DIR]="$HOME/cc-otel"
  [DOMAIN]="elio.fans"
  [SUBPATH]="/dashboard"
  [DASHBOARD_UID]="claude-code-otel"
  [TSDB_PATH]="$HOME/tsdb"
  [PROM_VOLUME_NAME]="cc-otel_prom-data"
  [GRAFANA_VOLUME_NAME]="cc-otel_grafana-data"
  [COLLECTOR_IMAGE]="otel/opentelemetry-collector-contrib:0.117.0"
  [PROMETHEUS_IMAGE]="prom/prometheus:v2.55.0"
  [GRAFANA_IMAGE]="grafana/grafana:11.4.0"
  [BIND_ADDR]="127.0.0.1"
  [OTLP_PORT]="4318"
  [PROM_EXPORTER_PORT]="8889"
  [PROMETHEUS_PORT]="9090"
  [GRAFANA_PORT]="3000"
  [ANONYMOUS_ROLE]="Viewer"
  [NGINX_CONF_DIR]="/etc/nginx/conf.d"
  [NGINX_SSL_CRT]="/etc/nginx/ssl/elio.fans_bundle.crt"
  [NGINX_SSL_KEY]="/etc/nginx/ssl/elio.fans.key"
  [SCHEME]="https"
)
def() { printf -v "$1" '%s' "${DEFAULTS[$1]:-}"; }

# ---------- 状态读写 ----------
state_file() { printf '%s/ccmon.state' "${INSTALL_DIR:-$(def INSTALL_DIR; printf %s "$INSTALL_DIR")}"; }
env_file()    { printf '%s/.env' "${INSTALL_DIR:-$(def INSTALL_DIR; printf %s "$INSTALL_DIR")}"; }

load_state() {
  def INSTALL_DIR
  [ -f "$(state_file)" ] || return 0
  # shellcheck disable=SC1090
  . "$(state_file)" 2>/dev/null || true
  # state 里的值覆盖默认值（变量与 key 同名）
  local k
  for k in "${!DEFAULTS[@]}"; do [ -n "${!k:-}" ] && DEFAULTS[$k]="${!k}"; done
}

save_state() { # 把 DEFAULTS 全量写入 state
  local f; f="$(state_file)"; : >"$f" && chmod 600 "$f"
  local k
  for k in "${!DEFAULTS[@]}"; do printf '%s=%q\n' "$k" "${DEFAULTS[$k]}" >>"$f"; done
}

load_env_into_defaults() { # 从既有 .env / 运行中的容器发现现值作为预填
  def INSTALL_DIR
  local f; f="$(env_file)"
  if [ -f "$f" ]; then
    local line k v
    while IFS= read -r line; do
      case "$line" in \#*|"") continue ;; esac
      k="${line%%=*}"; v="${line#*=}"
      [ -n "${DEFAULTS[$k]:-}" ] && DEFAULTS[$k]="$v"
    done <"$f"
  fi
  # 从运行中的 grafana 容器发现域名/子路径/版本（跨机器迁移时有用）
  if docker_cmd inspect cc-otel-grafana-1 >/dev/null 2>&1; then
    local dom root
    dom="$(docker_cmd inspect cc-otel-grafana-1 --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | sed -n 's/^GF_SERVER_DOMAIN=//p')"
    root="$(docker_cmd inspect cc-otel-grafana-1 --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | sed -n 's/^GF_SERVER_ROOT_URL=//p')"
    [ -n "$dom" ] && DEFAULTS[DOMAIN]="$dom"
    [[ "$root" == *"|"* || -z "$root" ]] || DEFAULTS[SUBPATH]="/${root##*/}"
  fi
}

# ---------- 配置模板写入 ----------
write_env_file() {
  local f; f="$(env_file)"
  cat >"$f" <<EOF
# ccmon 生成（ccmon setup）—— compose 插值用，改动请重跑 ccmon setup
INSTALL_DIR=${DEFAULTS[INSTALL_DIR]}
DOMAIN=${DEFAULTS[DOMAIN]}
SUBPATH=${DEFAULTS[SUBPATH]}
DASHBOARD_UID=${DEFAULTS[DASHBOARD_UID]}
TSDB_PATH=${DEFAULTS[TSDB_PATH]}
PROM_VOLUME_NAME=${DEFAULTS[PROM_VOLUME_NAME]}
GRAFANA_VOLUME_NAME=${DEFAULTS[GRAFANA_VOLUME_NAME]}
COLLECTOR_IMAGE=${DEFAULTS[COLLECTOR_IMAGE]}
PROMETHEUS_IMAGE=${DEFAULTS[PROMETHEUS_IMAGE]}
GRAFANA_IMAGE=${DEFAULTS[GRAFANA_IMAGE]}
BIND_ADDR=${DEFAULTS[BIND_ADDR]}
OTLP_PORT=${DEFAULTS[OTLP_PORT]}
PROM_EXPORTER_PORT=${DEFAULTS[PROM_EXPORTER_PORT]}
PROMETHEUS_PORT=${DEFAULTS[PROMETHEUS_PORT]}
GRAFANA_PORT=${DEFAULTS[GRAFANA_PORT]}
ANONYMOUS_ROLE=${DEFAULTS[ANONYMOUS_ROLE]}
SCHEME=${DEFAULTS[SCHEME]}
NGINX_SSL_CRT=${DEFAULTS[NGINX_SSL_CRT]}
NGINX_SSL_KEY=${DEFAULTS[NGINX_SSL_KEY]}
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
EOF
  chmod 600 "$f"
}

write_compose() {
  cat >"${DEFAULTS[INSTALL_DIR]}/docker-compose.yml" <<'YAML'
services:
  otel-collector:
    image: ${COLLECTOR_IMAGE}
    restart: unless-stopped
    command: ["--config=/etc/otelcol/config.yaml"]
    volumes:
      - ./otel-collector.yaml:/etc/otelcol/config.yaml:ro
      - ./data:/var/lib/otelcol
    ports:
      - "${BIND_ADDR}:${OTLP_PORT}:4318"
      - "${BIND_ADDR}:${PROM_EXPORTER_PORT}:8889"

  prometheus:
    restart: unless-stopped
    image: ${PROMETHEUS_IMAGE}
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prom-data:/prometheus
    ports:
      - "${BIND_ADDR}:${PROMETHEUS_PORT}:9090"

  grafana:
    restart: unless-stopped
    image: ${GRAFANA_IMAGE}
    volumes:
      - grafana-data:/var/lib/grafana
    ports:
      - "${BIND_ADDR}:${GRAFANA_PORT}:3000"
    environment:
      - GF_SERVER_DOMAIN=${DOMAIN}
      - GF_SERVER_ROOT_URL=${SCHEME}://${DOMAIN}${SUBPATH}
      - GF_SERVER_SERVE_FROM_SUB_PATH=true
      - GF_AUTH_ANONYMOUS_ENABLED=true
      - GF_AUTH_ANONYMOUS_ORG_ROLE=${ANONYMOUS_ROLE}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
      - GF_USERS_ALLOW_SIGN_UP=false

volumes:
  grafana-data:
    name: ${GRAFANA_VOLUME_NAME}
  prom-data:
    name: ${PROM_VOLUME_NAME}
    driver: local
    driver_opts:
      type: none
      device: ${TSDB_PATH}
      o: bind
YAML
}

write_collector_config() {
  cat >"${DEFAULTS[INSTALL_DIR]}/otel-collector.yaml" <<'YAML'
receivers:
  otlp:
    protocols:
      http:
        endpoint: 0.0.0.0:4318

exporters:
  prometheus:
    endpoint: 0.0.0.0:8889
  file:
    path: /var/lib/otelcol/cc-events.jsonl
    rotation:
      max_megabytes: 100
      max_days: 14
      max_backups: 5

service:
  pipelines:
    metrics:
      receivers: [otlp]
      exporters: [prometheus]
    logs:
      receivers: [otlp]
      exporters: [file]
YAML
}

write_prometheus_config() {
  cat >"${DEFAULTS[INSTALL_DIR]}/prometheus.yml" <<'YAML'
scrape_configs:
  - job_name: otel-collector
    scrape_interval: 15s
    static_configs:
      - targets: ["otel-collector:8889"]
YAML
}

