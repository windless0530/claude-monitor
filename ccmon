write_toollog_server() { # 只读 HTTP 服务（python3 stdlib，无第三方依赖）
  cat >"$(toollog_dir)/ccmon-sessions-server.py" <<'PYEOF'
#!/usr/bin/env python3
"""ccmon sessions viewer — 会话/工具调用日志的只读 HTTP 服务。

- GET /                     页面（--html 指定的文件）
- GET /api/health           健康检查 + 行数统计（ccmon status 用）
- GET /api/sessions         会话列表（按最近活跃倒序）
- GET /api/sessions/<id>    会话详情 + 轮次列表
- GET /api/turns/<id>       轮次详情 + 工具调用列表
- 后台线程按 --retention-days 清理旧数据（0=永久保留）
"""
import argparse
import json
import os
import sqlite3
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# 与 ccmon-hook.py 里的 SCHEMA 保持一致（服务启动时兜底建表/迁移，避免老库在 hook 首跑前查询报错）
SCHEMA = """
CREATE TABLE IF NOT EXISTS sessions(
  session_id      TEXT PRIMARY KEY,
  started_at      TEXT NOT NULL,
  ended_at        TEXT,
  cwd             TEXT,
  model           TEXT,
  main_transcript TEXT,
  last_prompt     TEXT,
  last_activity   TEXT,
  turn_count      INTEGER NOT NULL DEFAULT 0,
  tool_count      INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE IF NOT EXISTS turns(
  turn_id      INTEGER PRIMARY KEY AUTOINCREMENT,
  session_id   TEXT NOT NULL,
  prompt       TEXT NOT NULL,
  submitted_at TEXT NOT NULL,
  finished_at  TEXT,
  final_output TEXT,
  tool_count   INTEGER NOT NULL DEFAULT 0,
  llm_count    INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_turns_session ON turns(session_id, submitted_at);
CREATE TABLE IF NOT EXISTS tool_calls(
  call_id     INTEGER PRIMARY KEY AUTOINCREMENT,
  session_id  TEXT NOT NULL,
  turn_id     INTEGER,
  ts          TEXT NOT NULL,
  tool_name   TEXT NOT NULL,
  tool_input  TEXT,
  tool_response TEXT,
  is_subagent INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_calls_session ON tool_calls(session_id, call_id);
CREATE INDEX IF NOT EXISTS idx_calls_turn ON tool_calls(turn_id);
CREATE TABLE IF NOT EXISTS llm_calls(
  llm_id       INTEGER PRIMARY KEY AUTOINCREMENT,
  session_id   TEXT NOT NULL,
  turn_id      INTEGER,
  ts           TEXT NOT NULL,
  mid          TEXT,
  model        TEXT,
  stop_reason  TEXT,
  thinking     TEXT,
  text         TEXT,
  tool_uses    TEXT,
  input_tokens  INTEGER,
  output_tokens INTEGER,
  cache_read_tokens INTEGER,
  is_subagent  INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_llm_session ON llm_calls(session_id, llm_id);
CREATE INDEX IF NOT EXISTS idx_llm_turn ON llm_calls(turn_id);
CREATE INDEX IF NOT EXISTS idx_llm_mid ON llm_calls(session_id, mid);
"""

def jdump(obj):
    return json.dumps(obj, ensure_ascii=False).encode("utf-8")

class AppState:
    def __init__(self, db_path, html_path, retention_days):
        self.db_path = db_path
        self.html_path = html_path
        self.retention_days = retention_days
        self.bootstrap()

    def bootstrap(self): # 建表/迁移兜底（幂等；列级 ALTER 失败=已存在，忽略）
        c = self.conn()
        try:
            c.executescript(SCHEMA)
            for ddl in ("ALTER TABLE sessions ADD COLUMN llm_watermark TEXT",
                        "ALTER TABLE turns ADD COLUMN llm_count INTEGER NOT NULL DEFAULT 0"):
                try:
                    c.execute(ddl)
                except Exception:
                    pass
            c.commit()
        finally:
            c.close()

    def conn(self):
        c = sqlite3.connect(self.db_path, timeout=10)
        c.row_factory = sqlite3.Row
        c.execute("PRAGMA busy_timeout=10000")
        return c

    def prune(self):
        if self.retention_days <= 0:
            return 0
        cutoff = time.strftime("%Y-%m-%dT%H:%M:%S.000Z",
                               time.gmtime(time.time() - self.retention_days * 86400))
        c = self.conn()
        try:
            ids = [r[0] for r in c.execute(
                "SELECT session_id FROM sessions WHERE COALESCE(last_activity, started_at) < ?", (cutoff,))]
            if not ids:
                return 0
            qmarks = ",".join("?" * len(ids))
            c.execute(f"DELETE FROM llm_calls WHERE session_id IN ({qmarks})", ids)
            c.execute(f"DELETE FROM tool_calls WHERE session_id IN ({qmarks})", ids)
            c.execute(f"DELETE FROM turns WHERE session_id IN ({qmarks})", ids)
            c.execute(f"DELETE FROM sessions WHERE session_id IN ({qmarks})", ids)
            c.commit()
            c.execute("VACUUM")
            return len(ids)
        finally:
            c.close()

def prune_loop(state):
    while True:
        try:
            state.prune()
        except Exception as e:
            print(f"prune error: {e}", file=sys.stderr, flush=True)
        time.sleep(24 * 3600)

def row2dict(r):
    return {k: r[k] for k in r.keys()} if r is not None else None

def make_handler(state):
    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, fmt, *args):
            pass  # 静默访问日志（journald 里只留错误）

        def send_json(self, obj, code=200):
            body = jdump(obj)
            self.send_response(code)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            path = self.path.split("?", 1)[0].rstrip("/") or "/"
            try:
                if path == "/":
                    self.serve_index()
                elif path == "/api/health":
                    self.serve_health()
                elif path == "/api/sessions":
                    self.serve_sessions()
                elif path.startswith("/api/sessions/"):
                    self.serve_session(path[len("/api/sessions/"):])
                elif path.startswith("/api/turns/"):
                    self.serve_turn(path[len("/api/turns/"):])
                else:
                    self.send_json({"error": "not found"}, 404)
            except BrokenPipeError:
                pass
            except Exception as e:
                try:
                    self.send_json({"error": str(e)}, 500)
                except Exception:
                    pass

        def serve_index(self):
            try:
                with open(state.html_path, "rb") as f:
                    body = f.read()
            except Exception:
                body = b"<h1>ccmon sessions</h1><p>page file missing</p>"
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def serve_health(self):
            c = state.conn()
            try:
                counts = {
                    "sessions": c.execute("SELECT COUNT(*) FROM sessions").fetchone()[0],
                    "turns": c.execute("SELECT COUNT(*) FROM turns").fetchone()[0],
                    "tool_calls": c.execute("SELECT COUNT(*) FROM tool_calls").fetchone()[0],
                    "llm_calls": c.execute("SELECT COUNT(*) FROM llm_calls").fetchone()[0],
                }
            finally:
                c.close()
            self.send_json({"ok": True, "db": state.db_path, "counts": counts})

        def serve_sessions(self):
            c = state.conn()
            try:
                rows = c.execute(
                    "SELECT s.*, (SELECT COUNT(*) FROM llm_calls l WHERE l.session_id=s.session_id) AS llm_count"
                    " FROM sessions s ORDER BY COALESCE(s.last_activity, s.started_at) DESC LIMIT 200"
                ).fetchall()
            finally:
                c.close()
            self.send_json([row2dict(r) for r in rows])

        def serve_session(self, sid):
            c = state.conn()
            try:
                s = c.execute("SELECT * FROM sessions WHERE session_id=?", (sid,)).fetchone()
                if not s:
                    self.send_json({"error": "session not found"}, 404)
                    return
                turns = c.execute(
                    "SELECT * FROM turns WHERE session_id=? ORDER BY submitted_at DESC, turn_id DESC LIMIT 500",
                    (sid,)).fetchall()
            finally:
                c.close()
            self.send_json({"session": row2dict(s), "turns": [row2dict(t) for t in turns]})

        def serve_turn(self, tid):
            if not tid.isdigit():
                self.send_json({"error": "bad turn id"}, 400)
                return
            c = state.conn()
            try:
                t = c.execute("SELECT * FROM turns WHERE turn_id=?", (int(tid),)).fetchone()
                if not t:
                    self.send_json({"error": "turn not found"}, 404)
                    return
                calls = c.execute(
                    "SELECT * FROM tool_calls WHERE turn_id=? ORDER BY call_id ASC LIMIT 5000",
                    (int(tid),)).fetchall()
                llm = c.execute(
                    "SELECT llm_id, session_id, turn_id, ts, model, stop_reason, thinking, text,"
                    " tool_uses, input_tokens, output_tokens, cache_read_tokens, is_subagent"
                    " FROM llm_calls WHERE turn_id=? ORDER BY ts ASC, llm_id ASC LIMIT 2000",
                    (int(tid),)).fetchall()
            finally:
                c.close()
            self.send_json({"turn": row2dict(t),
                            "calls": [row2dict(x) for x in calls],
                            "llm": [row2dict(x) for x in llm]})

    return Handler

def main():
    here = os.path.dirname(os.path.abspath(__file__))
    ap = argparse.ArgumentParser()
    ap.add_argument("--db", default=os.path.join(here, "ccmon-sessions.db"))
    ap.add_argument("--html", default=os.path.join(here, "ccmon-sessions.html"))
    ap.add_argument("--bind", default="127.0.0.1")
    ap.add_argument("--port", type=int, default=7780)
    ap.add_argument("--retention-days", type=int, default=30)
    args = ap.parse_args()

    state = AppState(args.db, args.html, args.retention_days)
    try:
        state.prune()  # 启动即清一次
    except Exception as e:
        print(f"startup prune error: {e}", file=sys.stderr, flush=True)
    threading.Thread(target=prune_loop, args=(state,), daemon=True).start()

    srv = ThreadingHTTPServer((args.bind, args.port), make_handler(state))
    print(f"ccmon-sessions listening on {args.bind}:{args.port} db={args.db} "
          f"retention={args.retention_days}d", file=sys.stderr, flush=True)
    srv.serve_forever()

if __name__ == "__main__":
    main()
PYEOF
}

