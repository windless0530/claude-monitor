#!/usr/bin/env bash
# ccmon — Claude Code OTel 监控栈一键工具
#
# 接口:
#   ccmon setup          引导式安装/配置（幂等，可重复运行；不覆盖已有仪表盘）
#   ccmon reset-dashboard 恢复出厂仪表盘模板（确认+备份后覆盖，默认否）
#   ccmon restart        机器重启后拉起整个链路（docker + nginx + 校验）
#   ccmon start|stop     启停采集栈
#   ccmon status         全链路健康检查（只读）
#   ccmon events [N]     最近 N 次 API 调用明细（默认 10）
#   ccmon help
#
# 状态与配置: <INSTALL_DIR>/.env（compose 用）+ ccmon.state（本工具用），均 600 权限
# 所有修改操作（settings.json / nginx / compose）先备份再动手，nginx -t 失败自动回滚。

set -uo pipefail

# ---------- 基础工具 ----------
C_INFO=$'\033[1;32m'; C_WARN=$'\033[1;33m'; C_ERR=$'\033[1;31m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
info() { printf '%s[+]%s %s\n' "$C_INFO" "$C_OFF" "$*"; }
warn() { printf '%s[!]%s %s\n' "$C_WARN" "$C_OFF" "$*" >&2; }
err()  { printf '%s[x]%s %s\n' "$C_ERR" "$C_OFF" "$*" >&2; }
die()  { err "$*"; exit 1; }
hr()   { printf '%s── %s ──%s\n' "$C_DIM" "$*" "$C_OFF"; }

# 交互读取：回车=默认值；EOF/管道耗尽=默认值（可脚本化喂答案）
ask() { # ask <变量名> <提示> <默认值>
  local __ask_v __prompt="$2" __def="$3"
  printf '%s' "${__prompt} ${C_DIM}[${__def}]${C_OFF}: " >&2
  IFS= read -r __ask_v || __ask_v=""
  printf -v "$1" '%s' "${__ask_v:-$__def}"
}
ask_yn() { # ask_yn <变量名> <提示> <y|n>
  local _v __def="$3"
  ask _v "$2 (y/n)" "$__def"
  case "${_v,,}" in y|yes) printf -v "$1" 'y' ;; *) printf -v "$1" 'n' ;; esac
}
confirm_danger() { # 高危确认：必须显式输入变量值本身
  local _v
  printf '%s' "$1（输入该值确认）: " >&2
  IFS= read -r _v || _v=""
  [ "$_v" = "$2" ] || die "未确认，中止"
}

have() { command -v "$1" >/dev/null 2>&1; }
need() { have "$1" || die "缺少依赖: $1"; }

sudo_run() {
  if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi
}

# docker 需要时自动加 sudo（ubuntu 入组但旧会话未生效等场景）
docker_cmd() {
  if docker info >/dev/null 2>&1; then docker "$@"; else sudo docker "$@"; fi
}

