# ---------- 状态读写 ----------
state_file() { printf '%s/ccmon.state' "${INSTALL_DIR:-$(def INSTALL_DIR; printf %s "$INSTALL_DIR")}"; }
env_file()    { printf '%s/.env' "${INSTALL_DIR:-$(def INSTALL_DIR; printf %s "$INSTALL_DIR")}"; }

load_state() {
  def INSTALL_DIR
  [ -f "$(state_file)" ] || return 0
  # shellcheck disable=SC1090
  . "$(state_file)" 2>/dev/null || true
  # state 里的值覆盖默认值（变量与 key 同名）
  local k
  for k in "${!DEFAULTS[@]}"; do [ -n "${!k:-}" ] && DEFAULTS[$k]="${!k}"; done
}

save_state() { # 把 DEFAULTS 全量写入 state
  local f; f="$(state_file)"; : >"$f" && chmod 600 "$f"
  local k
  for k in "${!DEFAULTS[@]}"; do printf '%s=%q\n' "$k" "${DEFAULTS[$k]}" >>"$f"; done
}

load_env_into_defaults() { # 从既有 .env / 运行中的容器发现现值作为预填
  def INSTALL_DIR
  local f; f="$(env_file)"
  if [ -f "$f" ]; then
    local line k v
    while IFS= read -r line; do
      case "$line" in \#*|"") continue ;; esac
      k="${line%%=*}"; v="${line#*=}"
      [ -n "${DEFAULTS[$k]:-}" ] && DEFAULTS[$k]="$v"
    done <"$f"
  fi
  # 从运行中的 grafana 容器发现域名/子路径/版本（跨机器迁移时有用）
  if docker_cmd inspect cc-otel-grafana-1 >/dev/null 2>&1; then
    local dom root
    dom="$(docker_cmd inspect cc-otel-grafana-1 --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | sed -n 's/^GF_SERVER_DOMAIN=//p')"
    root="$(docker_cmd inspect cc-otel-grafana-1 --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | sed -n 's/^GF_SERVER_ROOT_URL=//p')"
    [ -n "$dom" ] && DEFAULTS[DOMAIN]="$dom"
    [[ "$root" == *"|"* || -z "$root" ]] || DEFAULTS[SUBPATH]="/${root##*/}"
  fi
}

