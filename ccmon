# ---------- 会话/工具日志（toollog）----------
toollog_dir() { printf '%s/toollog' "${DEFAULTS[INSTALL_DIR]}"; }
toollog_db()  { printf '%s/ccmon-sessions.db' "$(toollog_dir)"; }

write_toollog_hook() { # hooks 注入脚本（python3 stdlib；绝不失败，绝不打断 Claude）
  cat >"$(toollog_dir)/ccmon-hook.py" <<'PYEOF'
#!/usr/bin/env python3
"""ccmon toollog hook — Claude Code hook 事件 → SQLite。

设计约束（勿破坏）：
- 绝不失败：任何异常静默 exit 0，hook 不能打断/阻塞 Claude
- 快：单次 INSERT 级别操作（WAL + busy_timeout）
- db 路径 = 本脚本所在目录/ccmon-sessions.db（由 ccmon setup 部署）
"""
import datetime
import json
import os
import sqlite3
import sys
import time

RESP_LIMIT = 65536  # ccmon:resp-limit  （ccmon setup 会按 TOOLLOG_RESP_LIMIT 重写此行）
FINAL_SCAN = 262144 # Stop 时从 transcript 尾部倒扫的最大字节数
LLM_SCAN   = 524288 # 收割 LLM 调用时从 transcript 尾部扫描的最大字节数

DB = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ccmon-sessions.db")

SCHEMA = """
CREATE TABLE IF NOT EXISTS sessions(
  session_id      TEXT PRIMARY KEY,
  started_at      TEXT NOT NULL,
  ended_at        TEXT,
  cwd             TEXT,
  model           TEXT,
  main_transcript TEXT,
  last_prompt     TEXT,
  last_activity   TEXT,
  turn_count      INTEGER NOT NULL DEFAULT 0,
  tool_count      INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE IF NOT EXISTS turns(
  turn_id      INTEGER PRIMARY KEY AUTOINCREMENT,
  session_id   TEXT NOT NULL,
  prompt       TEXT NOT NULL,
  submitted_at TEXT NOT NULL,
  finished_at  TEXT,
  final_output TEXT,
  tool_count   INTEGER NOT NULL DEFAULT 0,
  llm_count    INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_turns_session ON turns(session_id, submitted_at);
CREATE TABLE IF NOT EXISTS tool_calls(
  call_id     INTEGER PRIMARY KEY AUTOINCREMENT,
  session_id  TEXT NOT NULL,
  turn_id     INTEGER,
  ts          TEXT NOT NULL,
  tool_name   TEXT NOT NULL,
  tool_input  TEXT,
  tool_response TEXT,
  is_subagent INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_calls_session ON tool_calls(session_id, call_id);
CREATE INDEX IF NOT EXISTS idx_calls_turn ON tool_calls(turn_id);
CREATE TABLE IF NOT EXISTS llm_calls(
  llm_id       INTEGER PRIMARY KEY AUTOINCREMENT,
  session_id   TEXT NOT NULL,
  turn_id      INTEGER,
  ts           TEXT NOT NULL,
  mid          TEXT,
  model        TEXT,
  stop_reason  TEXT,
  thinking     TEXT,
  text         TEXT,
  tool_uses    TEXT,
  input_tokens  INTEGER,
  output_tokens INTEGER,
  cache_read_tokens INTEGER,
  is_subagent  INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_llm_session ON llm_calls(session_id, llm_id);
CREATE INDEX IF NOT EXISTS idx_llm_turn ON llm_calls(turn_id);
CREATE INDEX IF NOT EXISTS idx_llm_mid ON llm_calls(session_id, mid);
"""

def ensure_migration(conn): # 旧库升级（列存在则忽略报错）
    for ddl in ("ALTER TABLE sessions ADD COLUMN llm_watermark TEXT",
                "ALTER TABLE turns ADD COLUMN llm_count INTEGER NOT NULL DEFAULT 0"):
        try:
            conn.execute(ddl)
        except Exception:
            pass

def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"

def clip(s, limit=None):
    limit = limit or RESP_LIMIT
    if s is None:
        return None
    if not isinstance(s, str):
        try:
            s = json.dumps(s, ensure_ascii=False)
        except Exception:
            s = str(s)
    if len(s) > limit:
        return s[:limit] + "\n…[ccmon truncated, %d chars omitted]" % (len(s) - limit)
    return s

def final_output_and_model(transcript_path, min_ts=None):
    """从 transcript 尾部倒扫，取主链最后一条含文本的 assistant 消息。

    min_ts：只接受 timestamp >= min_ts 的行（ISO 字符串比较），防止把上一轮的
    旧文本误当本轮最终输出（Stop 事件可能先于本轮文本落盘）。
    """
    try:
        with open(transcript_path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - FINAL_SCAN))
            data = f.read().decode("utf-8", "replace")
        for line in reversed(data.splitlines()):
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except Exception:
                continue
            if rec.get("type") != "assistant" or rec.get("isSidechain"):
                continue
            ts = rec.get("timestamp")
            if min_ts and isinstance(ts, str) and ts < min_ts:
                continue
            msg = rec.get("message") or {}
            texts = [c.get("text", "") for c in (msg.get("content") or [])
                     if isinstance(c, dict) and c.get("type") == "text"]
            text = "\n".join(t for t in texts if t).strip()
            if text:
                return clip(text), msg.get("model")
        return None, None
    except Exception:
        return None, None

def ensure_session(conn, evt, sid, ts):
    conn.execute(
        "INSERT OR IGNORE INTO sessions(session_id, started_at, cwd, main_transcript, last_activity)"
        " VALUES(?,?,?,?,?)",
        (sid, ts, evt.get("cwd"), evt.get("transcript_path"), ts))

def current_turn_id(conn, sid, ts):
    row = conn.execute(
        "SELECT turn_id FROM turns WHERE session_id=? AND submitted_at<=?"
        " ORDER BY submitted_at DESC, turn_id DESC LIMIT 1", (sid, ts)).fetchone()
    return row[0] if row else None

def on_prompt(conn, evt, sid, ts):
    ensure_session(conn, evt, sid, ts)
    # 补账：上一轮已结束但 final_output 为空（Stop 时 transcript 尚未 flush 的竞态）。
    # 此时新轮刚开始、transcript 尾部恰为上一轮的最终输出，直接提取即可。
    row = conn.execute(
        "SELECT turn_id, submitted_at FROM turns WHERE session_id=? AND finished_at IS NOT NULL"
        " AND final_output IS NULL ORDER BY turn_id DESC LIMIT 1", (sid,)).fetchone()
    if row:
        text, model = final_output_and_model(evt.get("transcript_path") or "", row["submitted_at"])
        if text:
            conn.execute("UPDATE turns SET final_output=? WHERE turn_id=?", (text, row[0]))
            if model:
                conn.execute("UPDATE sessions SET model=? WHERE session_id=?", (model, sid))
    conn.execute("INSERT INTO turns(session_id, prompt, submitted_at) VALUES(?,?,?)",
                 (sid, clip(evt.get("prompt") or ""), ts))
    conn.execute(
        "UPDATE sessions SET turn_count=turn_count+1, last_prompt=?, last_activity=?,"
        " main_transcript=COALESCE(?, main_transcript), ended_at=NULL WHERE session_id=?",
        (clip(evt.get("prompt") or "", 200), ts, evt.get("transcript_path"), sid))

def on_post_tool(conn, evt, sid, ts):
    ensure_session(conn, evt, sid, ts)
    tid = current_turn_id(conn, sid, ts)
    main = conn.execute("SELECT main_transcript FROM sessions WHERE session_id=?", (sid,)).fetchone()
    main_tp = main[0] if main else None
    tp = evt.get("transcript_path")
    is_sub = 1 if (main_tp and tp and tp != main_tp) else 0
    conn.execute(
        "INSERT INTO tool_calls(session_id, turn_id, ts, tool_name, tool_input, tool_response, is_subagent)"
        " VALUES(?,?,?,?,?,?,?)",
        (sid, tid, ts, evt.get("tool_name") or "?",
         clip(json.dumps(evt.get("tool_input"), ensure_ascii=False)) if evt.get("tool_input") is not None else None,
         clip(json.dumps(evt.get("tool_response"), ensure_ascii=False)),
         is_sub))
    conn.execute("UPDATE sessions SET tool_count=tool_count+1, last_activity=? WHERE session_id=?", (ts, sid))
    if tid:
        conn.execute("UPDATE turns SET tool_count=tool_count+1 WHERE turn_id=?", (tid,))
    harvest_llm(conn, sid, tp)

def harvest_llm(conn, sid, transcript_path):
    """从 transcript 尾部收割 LLM 推理调用（assistant 消息），写入 llm_calls。

    - 流式响应会把一次 API 调用拆成多行 assistant 记录（thinking 一行、tool_use 一行…），
      按 message.id 分组合并成一条，usage 取输出 token 数最大的分片（终值）。
    - 幂等：入库前按 (session_id, mid) 查重；sessions.llm_watermark 只用来缩小扫描范围。
    - 只记能归属到某轮次（turn）的组，避免 -c/--resume 续接旧 transcript 时把历史会话的
      消息误记到新会话名下。
    """
    if not transcript_path:
        return
    try:
        row = conn.execute("SELECT main_transcript, llm_watermark FROM sessions WHERE session_id=?", (sid,)).fetchone()
    except Exception:
        return
    if row is None:
        return
    main_tp, wm = row["main_transcript"], row["llm_watermark"]
    is_main = (not main_tp) or (transcript_path == main_tp)
    try:
        with open(transcript_path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - LLM_SCAN))
            data = f.read().decode("utf-8", "replace")
    except Exception:
        return
    groups = {}   # mid -> dict
    order = []
    for line in data.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
        except Exception:
            continue
        if rec.get("type") != "assistant":
            continue
        if is_main and rec.get("isSidechain"):
            continue
        rts = rec.get("timestamp") or ""
        if not rts or (wm and rts < wm):
            continue
        msg = rec.get("message") or {}
        mid = msg.get("id") or rts
        g = groups.get(mid)
        if g is None:
            g = groups[mid] = {"first": rts, "last": rts, "model": None, "stop": None,
                               "blocks": [], "usage": None, "out": -1}
            order.append(mid)
        if rts > g["last"]:
            g["last"] = rts
        g["model"] = g["model"] or msg.get("model")
        if msg.get("stop_reason"):
            g["stop"] = msg.get("stop_reason")
        g["blocks"].extend(c for c in (msg.get("content") or []) if isinstance(c, dict))
        u = msg.get("usage") or {}
        out = u.get("output_tokens")
        if isinstance(out, int) and out >= g["out"]:
            g["out"], g["usage"] = out, u
    max_ts = wm or ""
    for mid in order:
        g = groups[mid]
        if g["last"] > max_ts:
            max_ts = g["last"]
        tid = current_turn_id(conn, sid, g["last"])
        if tid is None:
            continue
        if conn.execute("SELECT 1 FROM llm_calls WHERE session_id=? AND mid=? LIMIT 1", (sid, mid)).fetchone():
            continue
        thinking = "\n".join(c.get("thinking", "") for c in g["blocks"]
                             if c.get("type") == "thinking").strip()
        text = "\n".join(c.get("text", "") for c in g["blocks"] if c.get("type") == "text").strip()
        names = [c.get("name", "?") for c in g["blocks"] if c.get("type") == "tool_use"]
        u = g["usage"] or {}
        conn.execute(
            "INSERT INTO llm_calls(session_id, turn_id, ts, mid, model, stop_reason, thinking, text,"
            " tool_uses, input_tokens, output_tokens, cache_read_tokens, is_subagent)"
            " VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)",
            (sid, tid, g["last"], mid, g["model"], g["stop"],
             clip(thinking) or None, clip(text) or None,
             json.dumps(names, ensure_ascii=False) if names else None,
             u.get("input_tokens"), u.get("output_tokens"), u.get("cache_read_input_tokens"),
             0 if is_main else 1))
        conn.execute("UPDATE turns SET llm_count=llm_count+1 WHERE turn_id=?", (tid,))
    if max_ts and max_ts > (wm or ""):
        conn.execute("UPDATE sessions SET llm_watermark=? WHERE session_id=?", (max_ts, sid))

def on_stop(conn, evt, sid, ts):
    row = conn.execute(
        "SELECT turn_id, submitted_at FROM turns WHERE session_id=? AND finished_at IS NULL"
        " ORDER BY submitted_at DESC, turn_id DESC LIMIT 1", (sid,)).fetchone()
    # transcript 尾部（最终输出、末次 LLM 响应）可能晚于 Stop 事件落盘：小退避重试（总 ≤1.2s，
    # 远小于 hook timeout）。final_output 带时间下界过滤：本轮文本没落盘时宁可为空
    # （下一轮 UserPromptSubmit 补账），不误取上一轮旧文本；每次尝试顺带收割 LLM 调用。
    tp = evt.get("transcript_path") or ""
    min_ts = row["submitted_at"] if row else None
    text, model = None, None
    for attempt in range(4):
        if attempt:
            time.sleep(0.4)
        harvest_llm(conn, sid, tp)
        text, model = final_output_and_model(tp, min_ts)
        if text:
            break
    if row:
        conn.execute("UPDATE turns SET finished_at=?, final_output=? WHERE turn_id=?",
                     (ts, text, row[0]))
    conn.execute("UPDATE sessions SET ended_at=?, last_activity=?, model=COALESCE(?, model) WHERE session_id=?",
                 (ts, ts, model, sid))

def main():
    if "--init" in sys.argv:  # ccmon setup 用：仅建库建表
        conn = sqlite3.connect(DB, timeout=10)
        conn.execute("PRAGMA journal_mode=WAL")
        conn.executescript(SCHEMA)
        ensure_migration(conn)
        conn.commit()
        conn.close()
        return 0
    try:
        evt = json.loads(sys.stdin.read())
    except Exception:
        return 0
    ev = evt.get("hook_event_name") or ""
    sid = evt.get("session_id") or ""
    if not ev or not sid:
        return 0
    ts = now_iso()
    conn = None
    try:
        conn = sqlite3.connect(DB, timeout=10)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute("PRAGMA busy_timeout=10000")
        conn.executescript(SCHEMA)
        ensure_migration(conn)
        if ev == "UserPromptSubmit":
            on_prompt(conn, evt, sid, ts)
        elif ev == "PostToolUse":
            on_post_tool(conn, evt, sid, ts)
        elif ev == "Stop":
            on_stop(conn, evt, sid, ts)
        elif ev in ("SubagentStop", "SessionEnd"):
            ensure_session(conn, evt, sid, ts)
            conn.execute("UPDATE sessions SET last_activity=? WHERE session_id=?", (ts, sid))
            if ev == "SessionEnd":
                # 会话退出时 transcript 必然已完整落盘：兜底收割漏掉的末次 LLM 调用
                harvest_llm(conn, sid, evt.get("transcript_path"))
                conn.execute("UPDATE sessions SET ended_at=? WHERE session_id=?", (ts, sid))
            else:
                harvest_llm(conn, sid, evt.get("transcript_path"))
        conn.commit()
    except Exception as e:  # 静默失败，但留旁路错误日志便于排查
        try:
            p = DB + ".err.log"
            with open(p, "a") as f:
                f.write("%s %s: %s\n" % (ts, type(e).__name__, e))
            if os.path.getsize(p) > 262144:  # 超 256KB 保留后半，防膨胀
                with open(p, "rb") as f:
                    data = f.read()
                with open(p, "wb") as f:
                    f.write(data[len(data) // 2:])
        except Exception:
            pass
    finally:
        try:
            if conn is not None:
                conn.close()
        except Exception:
            pass
    return 0

if __name__ == "__main__":
    sys.exit(main())
PYEOF
  sed -i "s/^RESP_LIMIT = .*/RESP_LIMIT = ${DEFAULTS[TOOLLOG_RESP_LIMIT]}  # ccmon:resp-limit/" "$(toollog_dir)/ccmon-hook.py"
